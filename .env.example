# Azure OpenAI / Azure AI Search settings used by this project.
# Authentication is expected to use DefaultAzureCredential or Managed Identity,
# so no API keys are required here.

AZURE_OPENAI_ENDPOINT=https://<your-azure-openai-resource>.services.ai.azure.com
AZURE_OPENAI_API_VERSION=2025-07-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=<your-chat-deployment>
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=<your-embedding-deployment>
AZURE_OPENAI_VISION_DEPLOYMENT=<your-vision-deployment>

AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_INDEX_NAME=<your-search-index-name>
AZURE_SEARCH_ADMIN_KEY=

# Optional runtime settings
USE_DEVELOPER_CREDENTIALS=true
AZURE_TENANT_ID=
MANAGED_IDENTITY_CLIENT_ID=
SEARCH_TOP=5
EXTRACTION_VERSION=v1

HOMESTYLE_AGENT_BEARER_TOKEN=<set-a-strong-random-token>

LOG_LEVEL=INFO
APPLICATION_INSIGHTS_CONNECTION_STRING=
ENABLE_INSTRUMENTATION=true
ENABLE_SENSITIVE_DATA=true
OTEL_SERVICE_NAME=homestyle-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:18889
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
